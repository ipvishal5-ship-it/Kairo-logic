# ==========================================
# Kairologic Notification & Storage Settings
# ==========================================

# Recipient email where contact form submissions will be delivered
ENQUIRY_RECIPIENT_EMAIL=your-email@gmail.com

# ------------------------------------------
# OPTION 1: Resend (Recommended, free 3,000 emails/mo, zero sleep/inactivity)
# Sign up at resend.com, grab API key, and optionally verify your domain
# ------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kairologic <onboarding@resend.dev>

# ------------------------------------------
# OPTION 2: Standard SMTP / Gmail (Zero cost forever)
# Use your Gmail address and a 16-character Google App Password (not your normal password)
# ------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ------------------------------------------
# OPTION 3: Permanent Google Sheets Webhook
# Unlimited storage, NEVER sleeps or pauses for inactivity, viewable in Google Drive/Sheets app
# Set up via Google Apps Script Web App (see docs/google-sheets-setup.md)
# ------------------------------------------
GOOGLE_SHEETS_WEBHOOK_URL=

# ------------------------------------------
# Site & SEO Configuration
# ------------------------------------------
# Public site origin (used for canonical URLs, Open Graph, sitemap.xml, and JSON-LD)
NEXT_PUBLIC_SITE_URL=https://kairologic.in

# Optional free analytics & SEO verification IDs
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
